-{"$schema":"https://ui.shadcn.com/schema/registry-item.json","name":"select","type":"registry:ui","title":"Select","description":"A compact choice field with a keyboard friendly menu.","categories":["inputs"],"dependencies":["@radix-ui/react-select","lucide-react","motion"],"registryDependencies":["https://ui.teamofsilicons.com/r/silicon-motion-tokens.json"],"files":[{"path":"registry/components/select/select.tsx","type":"registry:component","target":"@components/silicon-ui/select/select.tsx","content":"\"use client\";\n\nimport { forwardRef, useId, useState } from \"react\";\nimport type { ComponentPropsWithoutRef } from \"react\";\nimport * as SelectPrimitive from \"@radix-ui/react-select\";\nimport { AnimatePresence, motion, useReducedMotion } from \"motion/react\";\nimport type { Variants } from \"motion/react\";\nimport { Check, ChevronDown, ChevronUp } from \"lucide-react\";\nimport { MenuHighlight, useMenuHighlight } from \"../lib/menu-highlight\";\nimport { motionTokens } from \"../lib/motion-tokens\";\nimport styles from \"./select.module.css\";\n\nexport interface SelectProps extends Omit<ComponentPropsWithoutRef<typeof SelectPrimitive.Root>, \"children\"> {\n  label: string;\n  description?: string;\n  placeholder?: string;\n  id?: string;\n  className?: string;\n  options: { value: string; label: string; disabled?: boolean }[];\n}\n\n/** The shown value rolls in the direction of the list: a later option rises from below, an earlier one drops from above. */\nconst valueRoll: Variants = {\n  enter: (direction: number) => ({ opacity: 0, y: `${direction * 0.35}em`, filter: `blur(${motionTokens.blur.soft}px)` }),\n  center: { opacity: 1, y: 0, filter: \"blur(0px)\", transition: { duration: motionTokens.duration.standard, ease: [...motionTokens.ease.enter] } },\n  exit: (direction: number) => ({ opacity: 0, y: `${direction * -0.3}em`, filter: `blur(${motionTokens.blur.subtle}px)`, transition: { duration: motionTokens.duration.fast, ease: [...motionTokens.ease.standard] } }),\n};\n/** Reduced motion keeps a short crossfade; the resting state matches valueRoll so server and client markup agree. */\nconst valueFade: Variants = { enter: { opacity: 0 }, center: { opacity: 1, y: 0, filter: \"blur(0px)\", transition: { duration: motionTokens.duration.instant } }, exit: { opacity: 0, transition: { duration: motionTokens.duration.instant } } };\n\nexport const Select = forwardRef<HTMLButtonElement, SelectProps>(function Select(\n  { label, description, placeholder = \"Select an option\", options, id, className, disabled, onValueChange, ...rootProps },\n  ref,\n) {\n  const generatedId = useId();\n  const controlId = id ?? generatedId;\n  const hintId = description ? `${controlId}-description` : undefined;\n  const reduceMotion = useReducedMotion();\n  const { highlight, reset, contentProps } = useMenuHighlight();\n  const [uncontrolledValue, setUncontrolledValue] = useState(rootProps.defaultValue ?? \"\");\n  const currentValue = rootProps.value ?? uncontrolledValue;\n  const index = options.findIndex((option) => option.value === currentValue);\n  const shown = currentValue ? options[index]?.label ?? \"\" : placeholder;\n  const [previousIndex, setPreviousIndex] = useState(index);\n  const [direction, setDirection] = useState(1);\n  if (previousIndex !== index) { setPreviousIndex(index); setDirection(index > previousIndex ? 1 : -1); }\n\n  return (\n    <div className={styles.field}>\n      <label htmlFor={controlId}>{label}</label>\n      <SelectPrimitive.Root {...rootProps} disabled={disabled} onOpenChange={(open) => { if (open) reset(); rootProps.onOpenChange?.(open); }} onValueChange={(next) => { setUncontrolledValue(next); onValueChange?.(next); }}>\n        <SelectPrimitive.Trigger\n          ref={ref}\n          id={controlId}\n          aria-describedby={hintId}\n          className={[styles.trigger, className].filter(Boolean).join(\" \")}\n        >\n          {/* Radix keeps the real value for assistive tech; the visible copy below animates between values. */}\n          <span className={styles.srOnly}><SelectPrimitive.Value placeholder={placeholder} /></span>\n          <span className={styles.valueText} aria-hidden=\"true\">\n            <AnimatePresence initial={false} custom={direction}>\n              <motion.span key={currentValue ? `value-${currentValue}` : \"placeholder\"} data-placeholder={currentValue ? undefined : \"\"} custom={direction} variants={reduceMotion ? valueFade : valueRoll} initial=\"enter\" animate=\"center\" exit=\"exit\">{shown}</motion.span>\n            </AnimatePresence>\n          </span>\n          <SelectPrimitive.Icon className={styles.chevron}>\n            <ChevronDown size={16} strokeWidth={1.75} aria-hidden=\"true\" />\n          </SelectPrimitive.Icon>\n        </SelectPrimitive.Trigger>\n        <SelectPrimitive.Portal>\n          <SelectPrimitive.Content className={styles.content} position=\"popper\" sideOffset={4} collisionPadding={12} {...contentProps}>\n            <SelectPrimitive.ScrollUpButton className={styles.scrollButton}>\n              <ChevronUp size={16} strokeWidth={1.75} aria-hidden=\"true\" />\n            </SelectPrimitive.ScrollUpButton>\n            <SelectPrimitive.Viewport className={styles.viewport}>\n              <MenuHighlight state={highlight} className={styles.highlight} />\n              {options.map((option) => (\n                <SelectPrimitive.Item key={option.value} value={option.value} disabled={option.disabled} className={styles.item}>\n                  <SelectPrimitive.ItemText>{option.label}</SelectPrimitive.ItemText>\n                  <SelectPrimitive.ItemIndicator className={styles.indicator}>\n                    <Check size={16} strokeWidth={1.75} aria-hidden=\"true\" />\n                  </SelectPrimitive.ItemIndicator>\n                </SelectPrimitive.Item>\n              ))}\n            </SelectPrimitive.Viewport>\n            <SelectPrimitive.ScrollDownButton className={styles.scrollButton}>\n              <ChevronDown size={16} strokeWidth={1.75} aria-hidden=\"true\" />\n            </SelectPrimitive.ScrollDownButton>\n          </SelectPrimitive.Content>\n        </SelectPrimitive.Portal>\n      </SelectPrimitive.Root>\n      {description && <span id={hintId} className={styles.hint}>{description}</span>}\n    </div>\n  );\n});\n"},{"path":"registry/components/select/select.module.css","type":"registry:component","target":"@components/silicon-ui/select/select.module.css","content":".field { display: grid; gap: var(--space-related); min-width: 0; }\n.field label { font-size: var(--text-sm); font-weight: 500; }\n/* The trigger anchors the floating menu. Radix opens on pointerdown and measures this box, so it never scales: press feedback is color only. */\n.trigger { position: relative; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: var(--space-group); width: 100%; min-height: var(--control-height-md); border: 1px solid var(--border); border-radius: var(--radius-control); padding: 0 var(--space-group); background: var(--surface); color: var(--foreground); font: inherit; font-size: var(--text-sm); text-align: left; cursor: pointer; transition: border-color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), box-shadow var(--duration-fast) var(--ease-standard); }\n@media (hover: hover) and (pointer: fine) { .trigger:hover:not([data-disabled]) { border-color: var(--border-strong); background: var(--surface-muted); } }\n.trigger:active:not([data-disabled]), .trigger[data-state=\"open\"] { border-color: var(--border-strong); background: var(--surface-muted); }\n.trigger:focus-visible { border-color: var(--border-strong); }\n.trigger[data-disabled] { opacity: .5; cursor: not-allowed; }\n.valueText { display: grid; flex: 1; min-width: 0; grid-template-columns: minmax(0, 1fr); }\n.valueText > span { grid-area: 1 / 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.valueText > [data-placeholder] { color: var(--text-muted); }\n.srOnly { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }\n.chevron { display: inline-flex; flex: 0 0 auto; color: var(--text-muted); transition: transform var(--duration-spring) var(--ease-spring), color var(--duration-fast) var(--ease-standard); }\n.trigger[data-state=\"open\"] .chevron { transform: rotate(180deg); }\n.hint { color: var(--text-muted); font-size: var(--text-xs); }\n/* Radix holds the animation until the menu is positioned, so it always grows from the trigger edge. */\n.content { --menu-x: 0px; --menu-y: -6px; box-sizing: border-box; z-index: var(--layer-dropdown); width: var(--radix-select-trigger-width); min-width: var(--radix-select-trigger-width); max-width: min(24rem, calc(100vw - 20px)); max-height: min(320px, var(--radix-select-content-available-height)); overflow: hidden; border: 1px solid var(--border); border-radius: calc(var(--radius-control) + var(--space-hair)); padding: var(--space-related); background: var(--surface-raised); color: var(--foreground); box-shadow: var(--shadow-floating); transform-origin: var(--radix-select-content-transform-origin); animation: select-in var(--duration-standard) var(--ease-enter) both; }\n.content[data-side=\"top\"] { --menu-y: 6px; }\n.content[data-side=\"left\"] { --menu-x: 6px; --menu-y: 0px; }\n.content[data-side=\"right\"] { --menu-x: -6px; --menu-y: 0px; }\n.content[data-state=\"closed\"] { animation: select-out var(--duration-instant) var(--ease-standard) both; }\n.viewport { position: relative; padding: var(--space-hair) 0; }\n/* One highlight glides between options for the pointer and jumps instantly for the keyboard (lib/menu-highlight). */\n.highlight { position: absolute; top: 0; right: 0; left: 0; border-radius: calc(var(--radius-control) - var(--space-tight)); background: var(--surface-muted); opacity: 0; pointer-events: none; }\n.item { position: relative; display: flex; align-items: center; min-height: 36px; border-radius: calc(var(--radius-control) - var(--space-tight)); padding: 0 var(--space-block) 0 var(--space-group); color: var(--foreground); font-size: var(--text-sm); cursor: default; outline: none; user-select: none; transition: background-color var(--duration-instant) var(--ease-standard), color var(--duration-instant) var(--ease-standard); }\n.item[data-disabled] { opacity: .45; }\n.indicator { position: absolute; right: var(--space-group); display: inline-flex; align-items: center; color: var(--foreground); animation: indicator-in var(--duration-standard) var(--ease-enter) 40ms both; }\n.scrollButton { display: grid; height: 28px; place-items: center; color: var(--text-muted); }\n@keyframes select-in { from { opacity: 0; transform: translate(var(--menu-x), var(--menu-y)) scale(.97); } }\n@keyframes select-out { to { opacity: 0; transform: translate(calc(var(--menu-x) / 2), calc(var(--menu-y) / 2)) scale(.98); } }\n@keyframes indicator-in { from { opacity: 0; transform: scale(.6); filter: blur(2px); } }\n@media (prefers-reduced-transparency: reduce) { .content { background: var(--surface-raised); backdrop-filter: none; -webkit-backdrop-filter: none; } }\n@media (prefers-reduced-motion: reduce) { .trigger, .chevron, .item { transition: none; } .content { animation: select-fade var(--duration-instant) var(--ease-standard) both; } .content[data-state=\"closed\"] { animation: select-fade-out var(--duration-instant) var(--ease-standard) both; } .indicator { animation: none; } }\n@keyframes select-fade { from { opacity: 0; } }\n@keyframes select-fade-out { to { opacity: 0; } }\n"},{"path":"lib/menu-highlight.tsx","type":"registry:lib","target":"@components/silicon-ui/lib/menu-highlight.tsx","content":"\"use client\";\n\nimport { useRef } from \"react\";\nimport type { FocusEvent, MouseEvent } from \"react\";\nimport { motion, useReducedMotion } from \"motion/react\";\nimport { FluidHoverHighlight, useFluidHover, type FluidRect } from \"./fluid-hover\";\nimport { motionTokens } from \"./motion-tokens\";\n\n/** A fluid hover highlight in a menu: where it sits, whether it travels, its pointer session, and its tone. */\ntype FluidHighlight = { rect: FluidRect | null; glide: boolean; session: number; danger: boolean };\n/** A marker positioned by top and height only (a list's current-page marker). */\ntype BarHighlight = { top: number; height: number; danger: boolean; glide: boolean };\n\nconst ITEMS = '[role=\"menuitem\"], [role=\"menuitemcheckbox\"], [role=\"menuitemradio\"], [role=\"option\"]';\n\n/**\n * Fluid hover for a Radix menu or listbox (lib/fluid-hover): the item nearest the pointer is lit, gaps and padding\n * included, a click in a gap picks the lit item, and the keyboard moves the highlight with Radix's focus, without travel.\n * Spread `contentProps` on the content, call `reset` when it opens, and render `<MenuHighlight state={highlight} … />`\n * as its first child. Items mark a destructive tone with `data-tone=\"danger\"`.\n */\nexport function useMenuHighlight(itemSelector = ITEMS) {\n  // The content element is taken from its own events, so the hook never competes with the content's ref.\n  const content = useRef<HTMLElement | null>(null);\n  const hover = useFluidHover(content, { items: itemSelector });\n  const own = (event: { currentTarget: EventTarget }) => { content.current = event.currentTarget as HTMLElement; };\n  const { handlers } = hover;\n  const highlight: FluidHighlight = { rect: hover.rect, glide: hover.glide, session: hover.session, danger: hover.item?.dataset.tone === \"danger\" };\n  return {\n    highlight,\n    reset: hover.reset,\n    contentProps: {\n      onMouseEnter: (event: MouseEvent<HTMLElement>) => { own(event); handlers.onMouseEnter(); },\n      onMouseMove: (event: MouseEvent<HTMLElement>) => { own(event); handlers.onMouseMove(event); },\n      onMouseLeave: handlers.onMouseLeave,\n      onKeyDownCapture: handlers.onKeyDownCapture,\n      onFocus: (event: FocusEvent<HTMLElement>) => { own(event); handlers.onFocus(event); },\n      onBlur: handlers.onBlur,\n      onClick: (event: MouseEvent<HTMLElement>) => { own(event); handlers.onClick(event); },\n    },\n  };\n}\n\n/** The highlight itself: the fluid hover highlight, or a marker that moves by top and height (a current-page marker). */\nexport function MenuHighlight({ state, className }: { state: FluidHighlight | BarHighlight | null; className?: string }) {\n  if (state && \"session\" in state) return <FluidHoverHighlight hover={state} className={className} tone={state.danger ? \"danger\" : undefined} />;\n  return <BarMarker state={state} className={className} />;\n}\n\nfunction BarMarker({ state, className }: { state: BarHighlight | null; className?: string }) {\n  const reduced = useReducedMotion();\n  return <motion.span className={className} data-tone={state?.danger ? \"danger\" : undefined} aria-hidden=\"true\" initial={false}\n    animate={state ? { y: state.top, height: state.height, opacity: 1 } : { opacity: 0 }}\n    transition={{ default: state?.glide && !reduced ? motionTokens.spring.fast : { duration: 0 }, opacity: { duration: reduced ? 0 : motionTokens.duration.fast } }} />;\n}\n"},{"path":"lib/fluid-hover.tsx","type":"registry:lib","target":"@components/silicon-ui/lib/fluid-hover.tsx","content":"\"use client\";\n\n/**\n * Fluid hover: in a set of items (a menu, a list, tabs, a grid), the item nearest the pointer is lit, even while the\n * pointer is in a gap, the padding or past the last item, and one highlight springs between items. A click in a gap goes\n * to the lit item, so what is lit is what a click hits. A new pointer entry fades the highlight in where it lands instead\n * of sliding it over from the last item. The keyboard moves it without travel, and reduced motion keeps the fade but\n * drops the travel.\n *\n *   const list = useRef<HTMLUListElement>(null);\n *   const hover = useFluidHover(list, { items: \"[data-item]\" });\n *   <ul ref={list} className={styles.list} {...hover.handlers}>      // .list { position: relative }\n *     <FluidHoverHighlight hover={hover} className={styles.highlight} />\n *     …items…\n *   </ul>\n *\n * Adapted from Fluid Functionalism's use-fluid-hover and fluid-hover-highlight by Micka Touillaud (MIT),\n * https://github.com/mickadesign/fluid-functionalism. Items are found by a selector instead of registering themselves,\n * so a component adopts it without changing its items.\n */\nimport { useEffect, useEffectEvent, useRef, useState } from \"react\";\nimport type { FocusEvent, MouseEvent, PointerEvent, RefObject } from \"react\";\nimport { AnimatePresence, motion, useReducedMotion } from \"motion/react\";\nimport { motionTokens } from \"./motion-tokens\";\n\n/** An item's box in the container's own layout space (unaffected by transforms or scrolling). */\nexport interface FluidRect { top: number; left: number; width: number; height: number }\n\nexport interface FluidHoverState {\n  /** Where the highlight sits, or null when nothing is lit. */\n  rect: FluidRect | null;\n  /** The lit item. */\n  item: HTMLElement | null;\n  /** False when the highlight should jump (keyboard, a resize) rather than travel. */\n  glide: boolean;\n  /** Steps on each new pointer entry, so the highlight fades in where it lands. */\n  session: number;\n}\n\nexport interface FluidHoverOptions {\n  /** Selector for the items inside the container. */\n  items: string;\n  /** \"y\" for lists (default), \"x\" for a row of tabs, \"xy\" for grids. */\n  axis?: \"x\" | \"y\" | \"xy\";\n  /** Items the highlight skips (and a gap click never activates). Defaults to disabled or aria-disabled items. */\n  isItemDisabled?: (item: HTMLElement) => boolean;\n  /** \"skip\" (default) lights the nearest enabled item even over a disabled one; \"clear\" lights nothing over a disabled item (a calendar's unavailable days). */\n  disabled?: \"skip\" | \"clear\";\n  /** Route a click in a gap to the lit item. On by default; turn it off where empty space should stay inert. */\n  gapClick?: boolean;\n  /** Light the item that receives keyboard focus. On by default. */\n  followFocus?: boolean;\n}\n\nconst defaultDisabled = (item: HTMLElement) =>\n  item.matches(\":disabled, [aria-disabled='true'], [data-disabled]\");\n\n/** Controls that sit between items keep their own clicks. */\nconst CONTROL = \"input, textarea, select, button, a, summary, [contenteditable], [role='textbox'], [role='searchbox'], [role='button']\";\n\n/** The item's box relative to the container, summing offsets through positioned ancestors in between. */\nexport function rectOf(item: HTMLElement, container: HTMLElement): FluidRect {\n  let top = item.offsetTop, left = item.offsetLeft;\n  let parent = item.offsetParent as HTMLElement | null;\n  while (parent && parent !== container && container.contains(parent)) {\n    top += parent.offsetTop + parent.clientTop;\n    left += parent.offsetLeft + parent.clientLeft;\n    parent = parent.offsetParent as HTMLElement | null;\n  }\n  return { top, left, width: item.offsetWidth, height: item.offsetHeight };\n}\n\n/**\n * The item the pointer is inside, or else the one whose edge is nearest along the axis (both axes for a grid). Edges, not\n * centres, so a gap next to a wide item still lights the item the pointer is closer to.\n */\nexport function pickNearest(items: HTMLElement[], x: number, y: number, axis: \"x\" | \"y\" | \"xy\"): HTMLElement | null {\n  let nearest: HTMLElement | null = null, best = Infinity;\n  for (const item of items) {\n    const r = item.getBoundingClientRect();\n    if (!r.width && !r.height) continue;\n    if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) return item;\n    const dx = Math.max(r.left - x, 0, x - r.right), dy = Math.max(r.top - y, 0, y - r.bottom);\n    const distance = axis === \"x\" ? dx : axis === \"y\" ? dy : Math.hypot(dx, dy);\n    if (distance < best) { best = distance; nearest = item; }\n  }\n  return nearest;\n}\n\n/** Hands a gap click to the item as a real mouse click (detail, modifiers and coordinates kept), so the item reads it as a pointer press, not a keyboard one. */\nfunction forwardClick(item: HTMLElement, event: MouseEvent<HTMLElement>) {\n  const { detail, clientX, clientY, screenX, screenY, ctrlKey, shiftKey, altKey, metaKey, button, buttons } = event;\n  item.dispatchEvent(new globalThis.MouseEvent(\"click\", { bubbles: true, cancelable: true, composed: true, view: window, detail, clientX, clientY, screenX, screenY, ctrlKey, shiftKey, altKey, metaKey, button, buttons }));\n}\n\n/** Whether an event happened inside the element whose handler hears it, not in a portalled child (a submenu, a tooltip). */\nconst isOwn = (event: { currentTarget: EventTarget; target: EventTarget }) =>\n  !(event.currentTarget instanceof Node) || !(event.target instanceof Node) || event.currentTarget.contains(event.target);\n\nexport function useFluidHover<T extends HTMLElement>(container: RefObject<T | null>, options: FluidHoverOptions) {\n  const { items: selector, axis = \"y\", isItemDisabled = defaultDisabled, disabled = \"skip\", gapClick = true, followFocus = true } = options;\n  const [state, setState] = useState<FluidHoverState>({ rect: null, item: null, glide: false, session: 0 });\n  const current = useRef(state);\n  const pointer = useRef(false);\n  const entering = useRef(false);\n  const frame = useRef(0);\n\n  function commit(next: FluidHoverState) {\n    const prev = current.current;\n    if (prev.item === next.item && prev.session === next.session && sameRect(prev.rect, next.rect)) return;\n    current.current = next;\n    setState(next);\n  }\n\n  function light(item: HTMLElement | null, glide: boolean) {\n    const root = container.current;\n    if (!root || !item) return commit({ ...current.current, rect: null, item: null, glide });\n    let session = current.current.session;\n    if (entering.current) { entering.current = false; session += 1; }\n    commit({ rect: rectOf(item, root), item, glide: glide && session === current.current.session, session });\n  }\n\n  const enabledItems = () => {\n    const root = container.current;\n    return root ? [...root.querySelectorAll<HTMLElement>(selector)].filter(item => !isItemDisabled(item)) : [];\n  };\n\n  // The lit item can move under a still highlight (a resize, content above it changing): follow it without travel.\n  const follow = useEffectEvent(() => { const { item } = current.current; if (item?.isConnected) light(item, false); });\n  useEffect(() => {\n    const root = container.current;\n    if (!root || typeof ResizeObserver === \"undefined\") return;\n    const observer = new ResizeObserver(() => follow());\n    observer.observe(root);\n    return () => observer.disconnect();\n  }, [container]);\n  useEffect(() => () => cancelAnimationFrame(frame.current), []);\n\n  const handlers = {\n    onMouseEnter: () => { entering.current = true; },\n    onMouseMove: (event: MouseEvent<T>) => {\n      if (!isOwn(event)) return;\n      pointer.current = true;\n      const { clientX, clientY } = event;\n      cancelAnimationFrame(frame.current);\n      frame.current = requestAnimationFrame(() => {\n        const over = disabled === \"clear\" ? document.elementFromPoint(clientX, clientY)?.closest<HTMLElement>(selector) : null;\n        light(over && isItemDisabled(over) ? null : pickNearest(enabledItems(), clientX, clientY, axis), true);\n      });\n    },\n    onMouseLeave: () => { cancelAnimationFrame(frame.current); entering.current = false; light(null, false); },\n    onKeyDownCapture: () => { pointer.current = false; },\n    onFocus: (event: FocusEvent<T>) => {\n      if (!followFocus || pointer.current || !isOwn(event)) return;\n      const item = event.target instanceof HTMLElement ? event.target.closest<HTMLElement>(selector) : null;\n      if (item && container.current?.contains(item) && !isItemDisabled(item)) light(item, false);\n    },\n    onBlur: (event: FocusEvent<T>) => {\n      if (!pointer.current && !event.currentTarget.contains(event.relatedTarget as Node | null)) light(null, false);\n    },\n    onClick: (event: MouseEvent<T>) => {\n      if (!gapClick || !isOwn(event)) return;\n      const target = event.target as Element;\n      if (!target.isConnected || target.closest(selector) || target.closest(CONTROL)) return;\n      const { item } = current.current;\n      if (item?.isConnected && !isItemDisabled(item)) forwardClick(item, event);\n    },\n  };\n\n  /** Clears the highlight at once, such as when a menu opens again. */\n  const reset = () => { cancelAnimationFrame(frame.current); entering.current = true; light(null, false); };\n\n  return { ...state, handlers, reset, light };\n}\n\nexport interface NearestItemOptions extends Omit<FluidHoverOptions, \"followFocus\"> {\n  /** Called with the nearest enabled item as the mouse moves over the container. */\n  onPick: (item: HTMLElement) => void;\n}\n\n/**\n * Fluid hover's picking without its highlight, for a list that already keeps its own active item and highlight (a listbox\n * with aria-activedescendant, a roving list): the mouse picks the nearest enabled item, gaps and padding included, and a\n * click in a gap goes to that item. Spread the result on the container.\n */\n// A hook only so callbacks that touch refs can be passed during render; it keeps no state.\nexport function useNearestItem<T extends HTMLElement>({ items: selector, axis = \"y\", isItemDisabled = defaultDisabled, gapClick = true, onPick }: NearestItemOptions) {\n  const nearest = (event: MouseEvent<T>) => {\n    if (!isOwn(event)) return null;\n    const items = [...event.currentTarget.querySelectorAll<HTMLElement>(selector)].filter(item => !isItemDisabled(item));\n    return pickNearest(items, event.clientX, event.clientY, axis);\n  };\n  return {\n    onPointerMove: (event: PointerEvent<T>) => { if (event.pointerType !== \"mouse\") return; const item = nearest(event); if (item) onPick(item); },\n    onClick: (event: MouseEvent<T>) => {\n      if (!gapClick) return;\n      const target = event.target as Element;\n      if (!target.isConnected || target.closest(selector) || target.closest(CONTROL)) return;\n      const item = nearest(event);\n      if (item) forwardClick(item, event);\n    },\n  };\n}\n\nconst sameRect = (a: FluidRect | null, b: FluidRect | null) =>\n  a === b || (!!a && !!b && a.top === b.top && a.left === b.left && a.width === b.width && a.height === b.height);\n\nexport interface FluidHoverHighlightProps {\n  /** The state from useFluidHover (or any { rect, glide, session }). */\n  hover: Pick<FluidHoverState, \"rect\" | \"glide\" | \"session\">;\n  /** Radius, fill, z-index. The container must be position: relative; the highlight is placed at its top-left corner. */\n  className?: string;\n  /** Extra attributes for styling, such as data-tone. */\n  tone?: string;\n}\n\n/** The one highlight a fluid hover set renders: it springs between items on transforms, and fades in and out. */\nexport function FluidHoverHighlight({ hover, className, tone }: FluidHoverHighlightProps) {\n  const reduced = useReducedMotion() ?? false;\n  const { rect, glide, session } = hover;\n  const place = rect ? { x: rect.left, y: rect.top, width: rect.width, height: rect.height } : undefined;\n  return (\n    <AnimatePresence initial={false}>\n      {place ? (\n        <motion.span key={session} className={className} data-tone={tone} aria-hidden=\"true\"\n          style={{ position: \"absolute\", top: 0, left: 0, pointerEvents: \"none\" }}\n          initial={{ opacity: 0, ...place }}\n          animate={{ opacity: 1, ...place }}\n          exit={{ opacity: 0, transition: motionTokens.spring.fast.exit }}\n          transition={{ default: glide && !reduced ? motionTokens.spring.fast : { duration: 0 }, opacity: { duration: motionTokens.duration.fast } }} />\n      ) : null}\n    </AnimatePresence>\n  );\n}\n"}],"docs":"Docs and live preview: https://ui.teamofsilicons.com/select","meta":{"tier":"free","kind":"component","docs":"https://ui.teamofsilicons.com/select","markdown":"https://ui.teamofsilicons.com/select.md","tags":["field","form"],"status":"stable"}}
