W, trigger, WIDTH);\n    animate(shapeW, next.w, growing ? GROW : SHRINK);\n    animate(shapeH, next.h, growing ? GROW : SHRINK);\n  }, [anchorW, shapeH, shapeW]);\n\n  const read = useCallback(() => {\n    const measure = measureRef.current, control = controlRef.current, face = listFaceRef.current, root = rootRef.current;\n    if (!measure || !control || !face || !root) return false;\n    syncAnchor();\n    const panel = Math.min(PANEL_MAX, control.offsetWidth);\n    root.style.setProperty(\"--pi-panel-w\", `${panel}px`);\n    const previous = sizes.current;\n    const next = { trigger: measure.offsetWidth, lid: control.clientHeight, panel, list: face.offsetHeight };\n    sizes.current = next;\n    return next.trigger !== previous.trigger || next.lid !== previous.lid || next.panel !== previous.panel || (live.current.open && next.list !== previous.list);\n  }, [syncAnchor]);\n\n  useLayoutEffect(() => {\n    const measure = measureRef.current, control = controlRef.current, face = listFaceRef.current;\n    if (read()) place(live.current.measured);\n    if (!measure || !control || !face || typeof ResizeObserver === \"undefined\") return;\n    const observer = new ResizeObserver(() => { if (read()) place(live.current.measured); });\n    observer.observe(measure); observer.observe(control); observer.observe(face);\n    return () => observer.disconnect();\n  }, [place, read]);\n\n  // A fixed open surface escapes scrollable dialogs; keep it attached to the field as its ancestors scroll.\n  useEffect(() => {\n    if (!open) return;\n    window.addEventListener(\"scroll\", syncAnchor, true);\n    window.addEventListener(\"resize\", syncAnchor);\n    return () => { window.removeEventListener(\"scroll\", syncAnchor, true); window.removeEventListener(\"resize\", syncAnchor); };\n  }, [open, syncAnchor]);\n\n  const pendingFocus = useRef<\"trigger\" | \"search\" | \"number\" | null>(null);\n  useLayoutEffect(() => {\n    if (live.current.open !== open) { live.current.open = open; read(); place(true); }\n    const target = pendingFocus.current;\n    pendingFocus.current = null;\n    if (target === \"search\") searchRef.current?.focus({ preventScroll: true });\n    if (target === \"trigger\") triggerRef.current?.focus({ preventScroll: true });\n    if (target === \"number\") { const input = inputRef.current; input?.focus({ preventScroll: true }); input?.setSelectionRange(input.value.length, input.value.length); }\n  }, [open, place, read]);\n\n  /* The highlight glides between rows on its own spring. */\n  const hy = useMotionValue(0), hh = useMotionValue(0), ho = useMotionValue(0);\n  const scrollIntent = useRef(false);\n  useLayoutEffect(() => {\n    const node = open && activeKey ? rowRefs.current.get(activeKey) : undefined;\n    if (!node) { animate(ho, 0, { duration: reduced || !open ? 0 : .12, ease: standardEase }); return; }\n    const top = node.offsetTop, height = node.offsetHeight;\n    if (ho.get() < .05 || reduced) { hy.jump(top); hh.jump(height); } else { animate(hy, top, GLIDE); animate(hh, height, GLIDE); }\n    animate(ho, 1, { duration: reduced ? 0 : .12, ease: enterEase });\n    const scroller = scrollRef.current;\n    if (scroller && scrollIntent.current) {\n      scrollIntent.current = false;\n      const pad = 6;\n      if (top < scroller.scrollTop + pad) scroller.scrollTop = top - pad;\n      else if (top + height > scroller.scrollTop + scroller.clientHeight - pad) {\n        const needed = top + height - scroller.clientHeight + pad;\n        const nextStart = [...rowRefs.current.values()].map(row => row.offsetTop).filter(start => start >= needed).sort((a, b) => a - b)[0];\n        scroller.scrollTop = (nextStart ?? needed) + (parseFloat(getComputedStyle(scroller).paddingTop) || 0);\n      }\n    }\n  }, [activeKey, hh, ho, hy, open, reduced, sections]);\n\n  function openList(seed = \"\") {\n    if (disabled || open) return;\n    setQuery(seed);\n    const selectedRow = seed ? null : sections.flatMap(section => section.rows).find(row => row.entry.iso === current.iso && !row.key.startsWith(\"p-\")) ?? null;\n    setActive(selectedRow?.key ?? null);\n    scrollIntent.current = true;\n    pendingFocus.current = \"search\";\n    setAnnouncement(\"\");\n    setOpen(true);\n  }\n  const close = useCallback((focus: \"trigger\" | \"number\" | null) => {\n    pendingFocus.current = focus;\n    setOpen(false);\n  }, [setOpen]);\n\n  function pick(entry: PhoneCountry | undefined) {\n    if (!entry) return;\n    if (entry.iso !== current.iso) {\n      setRoll(Math.sign((orderOf.get(entry.iso) ?? 0) - (orderOf.get(current.iso) ?? 0)) || 1);\n      const nextDigits = draft === null ? digits : \"\";\n      if (countryProp === undefined) setState({ iso: entry.iso, digits: nextDigits, draft: null });\n      else setState(last => ({ ...last, digits: nextDigits, draft: null }));\n      onCountryChange?.(entry.iso);\n      emit(entry, nextDigits);\n      setAnnouncement(`${entry.name}, +${entry.dial}`);\n    } else if (draft !== null) {\n      setNumber(\"\", 0);\n    }\n    close(\"number\");\n  }\n\n  function move(key: string | null | undefined) {\n    if (!key) return;\n    scrollIntent.current = true;\n    setActive(key);\n  }\n\n  function onSearchKeyDown(event: ReactKeyboardEvent<HTMLInputElement>) {\n    const at = rows.findIndex(row => row.key === activeKey);\n    switch (event.key) {\n      case \"ArrowDown\": event.preventDefault(); move(rows[Math.min(rows.length - 1, at + 1)]?.key); return;\n      case \"ArrowUp\": event.preventDefault(); move(rows[Math.max(0, at - 1)]?.key); return;\n      case \"PageDown\": event.preventDefault(); move(rows[Math.min(rows.length - 1, at + PAGE)]?.key); return;\n      case \"PageUp\": event.preventDefault(); move(rows[Math.max(0, at - PAGE)]?.key); return;\n      case \"Home\": if (query) return; event.preventDefault(); move(rows[0]?.key); return;\n      case \"End\": if (query) return; event.preventDefault(); move(rows[rows.length - 1]?.key); return;\n      case \"Enter\": event.preventDefault(); pick(rows[at]?.entry); return;\n      case \"Escape\": event.preventDefault(); event.stopPropagation(); close(\"trigger\"); return;\n      case \"Tab\": close(null); return;\n    }\n  }\n\n  function onTriggerKeyDown(event: ReactKeyboardEvent<HTMLButtonElement>) {\n    if (event.key === \"ArrowDown\" || event.key === \"ArrowUp\") { event.preventDefault(); openList(); return; }\n    if (event.key.length === 1 && event.key !== \" \" && !event.metaKey && !event.ctrlKey && !event.altKey) { event.preventDefault(); openList(event.key); }\n  }\n\n  function onQuery(next: string) {\n    // Typing a whole number after \"+\" (the habit of writing \"+1 202 555 0142\") moves it into the number field as soon\n    // as it is more than a calling code, under its country; the rest of it goes on in the number field.\n    const typed = numberInSearch(next, pool);\n    if (typed) {\n      if (typed.country.iso !== current.iso) setAnnouncement(`Country set to ${typed.country.name}`);\n      setNumber(typed.national, typed.national.length, typed.country);\n      setQuery(\"\");\n      close(\"number\");\n      return;\n    }\n    setQuery(next);\n    setActive(null);\n    if (scrollRef.current) scrollRef.current.scrollTop = 0;\n    const text = next.trim().toLowerCase();\n    const count = text && text !== \"+\" ? pool.filter(entry => matchesQuery(entry, text)).length : pool.length;\n    setAnnouncement(text ? count ? `${count} ${count === 1 ? \"country\" : \"countries\"}` : \"No matches\" : \"\");\n  }\n\n  useEffect(() => {\n    if (!open) return;\n    const down = (event: PointerEvent) => { if (!rootRef.current?.contains(event.target as Node)) close(null); };\n    document.addEventListener(\"pointerdown\", down);\n    return () => document.removeEventListener(\"pointerdown\", down);\n  }, [close, open]);\n\n  const onRootBlur = (event: ReactFocusEvent<HTMLDivElement>) => {\n    const next = event.relatedTarget as Node | null;\n    if (open && next && !event.currentTarget.contains(next)) close(null);\n  };\n\n  const showCheck = status === \"valid\";\n  const invalid = !!message;\n  const describedBy = message ? errorId : description ? hintId : undefined;\n\n  const face = (entry: PhoneCountry) => <>\n    <span className={styles.flag} aria-hidden=\"true\">{flagOf(entry.iso)}</span>\n    <span className={styles.dial}>+{entry.dial}</span>\n  </>;\n\n  return <div ref={rootRef} className={[styles.field, className].filter(Boolean).join(\" \")} data-open={open || undefined} data-disabled={disabled || undefined} onBlur={onRootBlur}>\n    <label htmlFor={inputId} className={hideLabel ? styles.srOnly : styles.label}>{label}</label>\n\n    <div ref={controlRef} className={styles.control} data-invalid={invalid || undefined}>\n      <motion.div ref={anchorRef} className={styles.anchor} style={{ width: anchorW }}>\n        {/* Sizes the closed button: same padding and content, so the width spring has a target before anything moves. */}\n        <span ref={measureRef} className={`${styles.trigger} ${styles.measure}`} aria-hidden=\"true\">{face(current)}</span>\n\n        <motion.div className={styles.shape} style={{ width: shapeW, height: shapeH }}>\n          <div className={styles.lid}>\n            <button ref={triggerRef} type=\"button\" className={styles.trigger} disabled={disabled} inert={open || undefined} tabIndex={open ? -1 : 0}\n              aria-haspopup=\"listbox\" aria-expanded={open} aria-controls={listId} aria-label={`Country, ${current.name} +${current.dial}`}\n              onClick={() => (open ? close(\"trigger\") : openList())} onKeyDown={onTriggerKeyDown}>\n              <span className={styles.slot} data-hidden={open || undefined}>\n                <AnimatePresence initial={false} custom={roll}>\n                  <motion.span key={current.iso} className={styles.layer} custom={roll} variants={reduced ? layerFade : layerVariants} initial=\"enter\" animate=\"rest\" exit=\"exit\"\n                    transition={reduced ? { duration: motionTokens.duration.instant } : { y: GLIDE, opacity: { duration: motionTokens.duration.exit, ease: enterEase }, filter: { duration: motionTokens.duration.exit, ease: enterEase } }}>\n                    {face(current)}\n                  </motion.span>\n                </AnimatePresence>\n              </span>\n            </button>\n\n            <motion.div className={styles.searchRow} inert={!open || undefined} initial={false}\n              animate={open ? { opacity: 1, filter: \"blur(0px)\" } : { opacity: 0, filter: reduced ? \"blur(0px)\" : `blur(${blur.subtle}px)` }}\n              transition={open ? { duration: motionTokens.duration.exit, ease: enterEase, delay: reduced ? 0 : motionTokens.duration.instant } : { duration: motionTokens.duration.instant, ease: standardEase }}>\n              <Search className={styles.searchIcon} size={16} strokeWidth={1.75} aria-hidden=\"true\" />\n              <input ref={searchRef} className={styles.search} type=\"text\" role=\"combobox\" aria-label=\"Search countries or calling codes\" aria-expanded={open} aria-controls={listId}\n                aria-autocomplete=\"list\" aria-activedescendant={open && activeKey ? optionId(activeKey) : undefined} placeholder=\"Country or code\" value={query}\n                autoComplete=\"off\" spellCheck={false} onChange={event => onQuery(event.target.value)} onKeyDown={onSearchKeyDown} />\n              <AnimatePresence initial={false}>\n                {query && <motion.button key=\"clear\" type=\"button\" className={styles.clear} aria-label=\"Clear search\" onPointerDown={event => event.preventDefault()}\n                  onClick={() => { onQuery(\"\"); searchRef.current?.focus(); }}\n                  initial={{ opacity: 0, scale: .6 }} animate={{ opacity: 1, scale: 1 }} exit={{ opacity: 0, scale: .6, transition: { duration: motionTokens.duration.instant } }} transition={reduced ? { duration: 0 } : GLIDE}>\n                  <X size={14} strokeWidth={1.75} aria-hidden=\"true\" />\n                </motion.button>}\n              </AnimatePresence>\n              <button type=\"button\" className={styles.closeHit} aria-label=\"Close country list\" onClick={() => close(\"trigger\")} />\n            </motion.div>\n\n            <motion.span className={styles.chevron} aria-hidden=\"true\" initial={false} animate={{ rotate: open ? 180 : 0 }} transition={reduced ? { duration: 0 } : GLIDE}>\n              <ChevronDown size={16} strokeWidth={1.75} />\n            </motion.span>\n          </div>\n\n          <motion.div ref={listFaceRef} className={styles.listFace} inert={!open || undefined} aria-hidden={!open || undefined} initial={false}\n            animate={open ? { opacity: 1, y: 0, filter: \"blur(0px)\" } : { opacity: 0, y: reduced ? 0 : -6, filter: reduced ? \"blur(0px)\" : `blur(${blur.subtle}px)` }}\n            transition={open ? { y: GROW, opacity: { duration: motionTokens.duration.exit, ease: enterEase, delay: reduced ? 0 : motionTokens.stagger.word }, filter: { duration: motionTokens.duration.exit, ease: enterEase, delay: motionTokens.stagger.word } } : { duration: motionTokens.duration.instant, ease: standardEase }}>\n            <div ref={scrollRef} className={styles.scroll}>\n              <div id={listId} className={styles.options} role=\"listbox\" aria-label=\"Countries\" onPointerDown={event => event.preventDefault()} {...nearest}>\n                <motion.span className={styles.highlight} style={{ y: hy, height: hh, opacity: ho }} aria-hidden=\"true\" />\n                {sections.map(section => {\n                  const body = section.rows.map(row => {\n                    const selected = row.entry.iso === current.iso;\n                    return <div key={row.key} id={optionId(row.key)} role=\"option\" aria-selected={selected} className={styles.option} data-active={row.key === activeKey || undefined}\n                      ref={node => { if (node) rowRefs.current.set(row.key, node); else rowRefs.current.delete(row.key); }}\n                      data-key={row.key} onPointerDown={event => event.preventDefault()} onClick={() => pick(row.entry)}>\n                      <span className={styles.flag} aria-hidden=\"true\">{flagOf(row.entry.iso)}</span>\n                      <span className={styles.name}>{row.entry.name}</span>\n                      <span className={styles.meta}>+{row.entry.dial}</span>\n                      <span className={styles.check} data-on={selected || undefined} aria-hidden=\"true\"><Check size={16} strokeWidth={1.75} /></span>\n                    </div>;\n                  });\n                  return section.label\n                    ? <div key={section.key} role=\"group\" aria-labelledby={`${uid}-${section.key}`} className={styles.group}>\n                      <div id={`${uid}-${section.key}`} className={styles.groupLabel} role=\"presentation\">{section.label}</div>{body}\n                    </div>\n                    : <div key={section.key} role=\"presentation\" className={styles.group}>{body}</div>;\n                })}\n                {rows.length === 0 && <p className={styles.empty}>No countries match “{query.trim()}”</p>}\n              </div>\n            </div>\n          </motion.div>\n        </motion.div>\n      </motion.div>\n\n      <div className={styles.numberWrap}>\n        <span className={styles.guide} aria-hidden=\"true\"><span className={styles.guideTyped}>{formatted}</span>{guide}</span>\n        <input ref={inputRef} id={inputId} className={styles.number} type=\"tel\" inputMode=\"tel\" autoComplete=\"tel\" value={formatted} disabled={disabled} required={required}\n          aria-invalid={invalid || undefined} aria-describedby={describedBy} aria-label={hideLabel ? label : undefined}\n          onChange={event => onNumberChange(event.currentTarget)} onKeyDown={onNumberKeyDown} onPaste={onPaste}\n          onBlur={event => { setTouched(digits.length > 0); onBlur?.(event); }} />\n        <AnimatePresence initial={false}>\n          {showCheck && <motion.span key=\"ok\" className={styles.valid} aria-hidden=\"true\"\n            initial={reduced ? { opacity: 0 } : { opacity: 0, scale: .6, filter: `blur(${blur.subtle}px)` }} animate={{ opacity: 1, scale: 1, filter: \"blur(0px)\" }}\n            exit={{ opacity: 0, scale: reduced ? 1 : .8, transition: { duration: motionTokens.duration.instant } }} transition={reduced ? { duration: motionTokens.duration.instant } : motionTokens.spring.snappy}>\n            <Check size={16} strokeWidth={2} />\n          </motion.span>}\n        </AnimatePresence>\n      </div>\n    </div>\n\n    <AnimatePresence initial={false}>{description && !message && <MessageRow key=\"hint\" id={hintId} text={description} tone=\"hint\" />}</AnimatePresence>\n    <AnimatePresence initial={false}>{message && <MessageRow key=\"error\" id={errorId} text={message} tone=\"error\" />}</AnimatePresence>\n    {name && <input type=\"hidden\" name={name} value={e164} disabled={disabled} />}\n    <span className={styles.srOnly} role=\"status\" aria-live=\"polite\">{announcement || (showCheck ? `Valid ${current.name} number` : \"\")}</span>\n  </div>;\n});\n\nPhoneInput.displayName = \"PhoneInput\";\n\nexport default PhoneInput;\n"},{"path":"registry/components/phone-input/phone-input.module.css","type":"registry:component","target":"@components/silicon-ui/phone-input/phone-input.module.css","content":"/* No row gap: grid tracks clamp a negative margin at zero, so a closed message row would still pay the gap. Each row carries its own space instead. */\n.field { --pi-h: var(--control-height-md); --pi-panel-w: 320px; --pi-chevron-size: 16px; --pi-content-inset: calc(var(--space-tight) + var(--space-related)); --pi-chevron-clearance: calc(var(--pi-chevron-size) + var(--space-group) + var(--space-related)); position: relative; display: grid; min-width: 0; font-family: var(--font-body); letter-spacing: var(--tracking-body); }\n.field[data-open] { z-index: var(--layer-dropdown); }\n.label { justify-self: start; margin-bottom: var(--space-related); color: var(--foreground); font-size: var(--text-sm); font-weight: 500; line-height: var(--leading-body); }\n\n/* The shell matches the labeled input: one border, one radius, and a quiet border change on hover and focus. */\n.control { position: relative; display: flex; min-width: 0; height: var(--pi-h); box-sizing: border-box; border: 1px solid var(--border-strong); border-radius: var(--radius-control); corner-shape: var(--corner-shape); background: var(--surface); transition: border-color var(--duration-fast) var(--ease-standard); }\n@media (hover: hover) and (pointer: fine) { .control:hover:not([data-invalid]) { border-color: var(--foreground); } }\n.control:has(.number:focus) { border-color: var(--foreground); }\n.control[data-invalid] { border-color: var(--danger); }\n.field[data-disabled] .control { opacity: .5; background: var(--surface-muted); }\n\n/* The anchor holds the closed button's place and springs to a new width when the calling code changes length. */\n.anchor { position: relative; flex: none; height: 100%; }\n.anchor::after { content: \"\"; position: absolute; top: var(--space-group); right: 0; bottom: var(--space-group); width: 1px; background: var(--border); transition: opacity var(--duration-fast) var(--ease-standard); }\n.field[data-open] .anchor::after { opacity: 0; }\n\n/* One material for both states. Open, it steps out over the shell's own border so the two edges never double up. */\n.shape { position: absolute; z-index: 2; top: 0; left: 0; overflow: clip; border-radius: var(--radius-control); corner-shape: var(--corner-shape); background: var(--surface); transition: box-shadow var(--duration-considered) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard); }\n.shape::after { content: \"\"; position: absolute; inset: 0; z-index: 3; border: 1px solid var(--border); border-radius: inherit; corner-shape: inherit; opacity: 0; pointer-events: none; transition: opacity var(--duration-fast) var(--ease-standard); }\n.field[data-open] .shape { position: fixed; top: var(--pi-anchor-top, 0px); left: var(--pi-anchor-left, 0px); translate: -1px -1px; background: var(--surface-raised); box-shadow: var(--shadow-floating); }\n.field[data-open] .shape::after { opacity: 1; }\n.field[data-disabled] .shape { background: transparent; }\n\n.lid { position: absolute; z-index: 1; top: 0; right: 0; left: 0; height: calc(var(--pi-h) - 2px); }\n\n.trigger { box-sizing: border-box; display: flex; height: calc(var(--pi-h) - 2px); align-items: center; padding: 0 var(--pi-chevron-clearance) 0 var(--pi-content-inset); font-size: var(--text-sm); font-weight: 500; white-space: nowrap; }\n.lid .trigger { position: absolute; inset: var(--space-tight) auto var(--space-tight) var(--space-tight); width: calc(100% - 6px); height: auto; margin: 0; padding: 0 var(--pi-chevron-clearance) 0 var(--space-related); border: 0; border-radius: calc(var(--radius-control) - var(--space-tight)); corner-shape: var(--corner-shape); background: transparent; color: var(--foreground); cursor: pointer; font-family: inherit; letter-spacing: inherit; text-align: left; -webkit-tap-highlight-color: transparent; touch-action: manipulation; transition: background-color var(--duration-fast) var(--ease-standard); }\n@media (hover: hover) and (pointer: fine) { .field:not([data-open], [data-disabled]) .lid .trigger:hover { background: var(--surface-muted); } }\n.lid .trigger:active:not(:disabled) { background: var(--surface-muted); }\n.lid .trigger:disabled { cursor: not-allowed; }\n/* No focus rings (product decision): keyboard focus reads as the same quiet fill as hover. */\n.lid .trigger:focus-visible { background: var(--surface-muted); }\n.clear:focus-visible, .closeHit:focus-visible { background: color-mix(in oklab, var(--foreground) 8%, transparent); }\n/* An invisible copy with the visible content's inset and gap, so the closed button has its full width. */\n.measure { visibility: hidden; pointer-events: none; width: max-content; }\n.measure, .layer { gap: var(--space-related); }\n\n.slot { position: relative; display: block; min-width: 0; height: 100%; flex: 1; }\n.slot[data-hidden] { opacity: 0; transition: opacity var(--duration-instant) var(--ease-standard); }\n.layer { position: absolute; inset: 0; display: flex; align-items: center; }\n.flag { display: inline-grid; width: 20px; flex: none; place-items: center; font-family: \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Noto Color Emoji\", var(--font-body); font-size: var(--text-lg); font-weight: 400; line-height: 1; }\n.dial { font-variant-numeric: tabular-nums; }\n\n.chevron { position: absolute; top: 50%; right: var(--space-group); display: grid; width: var(--pi-chevron-size); height: var(--pi-chevron-size); margin-top: calc(var(--pi-chevron-size) / -2); place-items: center; color: var(--text-muted); pointer-events: none; }\n\n/* Search takes the lid's place while the list is open. */\n.searchRow { position: absolute; inset: 0; display: flex; align-items: center; gap: var(--space-related); padding: 0 var(--space-hair) 0 var(--space-group); }\n.searchRow[inert] { pointer-events: none; }\n.searchIcon { flex: none; color: var(--text-muted); }\n.search { min-width: 0; height: 100%; flex: 1; padding: 0; border: 0; background: transparent; color: var(--foreground); font: inherit; font-size: var(--text-sm); letter-spacing: var(--tracking-body); outline: none; }\n.search::placeholder { color: var(--text-muted); }\n.clear { display: grid; width: 24px; height: 24px; flex: none; place-items: center; padding: 0; border: 0; border-radius: var(--radius-full); corner-shape: round; background: color-mix(in oklab, var(--foreground) 8%, transparent); color: var(--text-secondary); cursor: pointer; -webkit-tap-highlight-color: transparent; }\n/* Sits over the shared chevron, so the chevron closes the list. */\n.closeHit { width: 36px; height: 36px; flex: none; padding: 0; border: 0; border-radius: var(--radius-full); corner-shape: round; background: transparent; cursor: pointer; -webkit-tap-highlight-color: transparent; transition: background-color var(--duration-fast) var(--ease-standard); }\n@media (hover: hover) and (pointer: fine) {\n  .closeHit:hover, .clear:hover { background: color-mix(in oklab, var(--foreground) 8%, transparent); }\n  .clear:hover { color: var(--foreground); }\n}\n\n/* The list hangs under the lid at its final width, so rows never reflow while the surface springs open. */\n.listFace { position: absolute; top: calc(var(--pi-h) - var(--space-hair)); left: 0; box-sizing: border-box; width: var(--pi-panel-w); padding: 0 var(--space-related) var(--space-related); }\n.listFace::before { content: \"\"; position: absolute; top: 0; right: var(--space-inset); left: var(--space-inset); height: 1px; background: var(--border-subtle); }\n.listFace[inert] { pointer-events: none; }\n.scroll { max-height: 272px; overflow-y: auto; overscroll-behavior: contain; padding-top: var(--space-related); scrollbar-width: thin; }\n.options { position: relative; display: grid; gap: var(--space-hair); }\n.highlight { position: absolute; top: 0; right: 0; left: 0; border-radius: var(--radius-control); corner-shape: var(--corner-shape); background: color-mix(in oklab, var(--foreground) 6.5%, transparent); pointer-events: none; }\n.group { display: grid; gap: var(--space-hair); }\n.group + .group { margin-top: var(--space-tight); }\n.groupLabel { padding: var(--space-related) var(--space-group) var(--space-tight); color: var(--text-muted); font-size: var(--text-xs); }\n.option { position: relative; display: flex; min-height: 36px; box-sizing: border-box; align-items: center; gap: var(--space-group); padding: 0 var(--space-group); border-radius: var(--radius-control); corner-shape: var(--corner-shape); color: var(--text-secondary); cursor: pointer; font-size: var(--text-sm); user-select: none; -webkit-user-select: none; transition: color var(--duration-fast) var(--ease-standard); }\n.option[data-active], .option[aria-selected=\"true\"] { color: var(--foreground); }\n.name { min-width: 0; flex: 1; overflow: hidden; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }\n.meta { flex: none; color: var(--text-muted); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }\n.check { display: grid; width: 16px; height: 16px; flex: none; place-items: center; color: var(--foreground); opacity: 0; transform: scale(.6); transition: opacity var(--duration-fast) var(--ease-standard), transform var(--duration-spring) var(--ease-spring); }\n.check[data-on] { opacity: 1; transform: none; }\n.empty { margin: 0; padding: var(--space-group) var(--space-group) var(--space-inset); color: var(--text-muted); font-size: var(--text-sm); }\n\n/* The number and its guide share one box. The guide paints the typed part invisibly, then the rest of the example faintly after it. */\n.numberWrap { position: relative; display: flex; min-width: 0; flex: 1; align-items: center; }\n.number, .guide { box-sizing: border-box; padding: 0 var(--space-block) 0 var(--space-group); font-family: inherit; font-size: var(--text-sm); font-variant-numeric: tabular-nums; letter-spacing: var(--tracking-body); line-height: var(--leading-body); }\n.number { position: relative; z-index: 1; width: 100%; height: 100%; min-width: 0; margin: 0; border: 0; border-radius: 0 var(--radius-control) var(--radius-control) 0; corner-shape: var(--corner-shape); background: transparent; color: var(--foreground); outline: none; }\n.number:disabled { cursor: not-allowed; }\n.guide { position: absolute; inset: 0; display: flex; align-items: center; overflow: hidden; color: color-mix(in oklab, var(--text-muted) 72%, transparent); pointer-events: none; white-space: pre; }\n.guideTyped { visibility: hidden; }\n.valid { position: absolute; z-index: 1; top: 50%; right: var(--space-group); display: grid; width: 18px; height: 18px; margin-top: calc(var(--space-related) * -1); place-items: center; color: var(--success); pointer-events: none; }\n\n/* The row's space is padding inside the clipped slot, so the height animates from a true zero. */\n.messageSlot { position: relative; display: block; overflow: hidden; }\n.hint, .error { display: block; padding-top: var(--space-related); font-size: var(--text-xs); line-height: var(--leading-body); }\n.hint { color: var(--text-muted); }\n.error { color: var(--danger); }\n\n.srOnly { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }\n\n@media (prefers-reduced-motion: reduce) {\n  .shape, .shape::after, .check, .slot, .control { transition-duration: 0ms; }\n}\n@media (prefers-contrast: more) { .shape::after { border-color: var(--border-strong); } }\n"},{"path":"lib/fluid-hover.tsx","type":"registry:lib","target":"@components/silicon-ui/lib/fluid-hover.tsx","content":"\"use client\";\n\n/**\n * Fluid hover: in a set of items (a menu, a list, tabs, a grid), the item nearest the pointer is lit, even while the\n * pointer is in a gap, the padding or past the last item, and one highlight springs between items. A click in a gap goes\n * to the lit item, so what is lit is what a click hits. A new pointer entry fades the highlight in where it lands instead\n * of sliding it over from the last item. The keyboard moves it without travel, and reduced motion keeps the fade but\n * drops the travel.\n *\n *   const list = useRef<HTMLUListElement>(null);\n *   const hover = useFluidHover(list, { items: \"[data-item]\" });\n *   <ul ref={list} className={styles.list} {...hover.handlers}>      // .list { position: relative }\n *     <FluidHoverHighlight hover={hover} className={styles.highlight} />\n *     …items…\n *   </ul>\n *\n * Adapted from Fluid Functionalism's use-fluid-hover and fluid-hover-highlight by Micka Touillaud (MIT),\n * https://github.com/mickadesign/fluid-functionalism. Items are found by a selector instead of registering themselves,\n * so a component adopts it without changing its items.\n */\nimport { useEffect, useEffectEvent, useRef, useState } from \"react\";\nimport type { FocusEvent, MouseEvent, PointerEvent, RefObject } from \"react\";\nimport { AnimatePresence, motion, useReducedMotion } from \"motion/react\";\nimport { motionTokens } from \"./motion-tokens\";\n\n/** An item's box in the container's own layout space (unaffected by transforms or scrolling). */\nexport interface FluidRect { top: number; left: number; width: number; height: number }\n\nexport interface FluidHoverState {\n  /** Where the highlight sits, or null when nothing is lit. */\n  rect: FluidRect | null;\n  /** The lit item. */\n  item: HTMLElement | null;\n  /** False when the highlight should jump (keyboard, a resize) rather than travel. */\n  glide: boolean;\n  /** Steps on each new pointer entry, so the highlight fades in where it lands. */\n  session: number;\n}\n\nexport interface FluidHoverOptions {\n  /** Selector for the items inside the container. */\n  items: string;\n  /** \"y\" for lists (default), \"x\" for a row of tabs, \"xy\" for grids. */\n  axis?: \"x\" | \"y\" | \"xy\";\n  /** Items the highlight skips (and a gap click never activates). Defaults to disabled or aria-disabled items. */\n  isItemDisabled?: (item: HTMLElement) => boolean;\n  /** \"skip\" (default) lights the nearest enabled item even over a disabled one; \"clear\" lights nothing over a disabled item (a calendar's unavailable days). */\n  disabled?: \"skip\" | \"clear\";\n  /** Route a click in a gap to the lit item. On by default; turn it off where empty space should stay inert. */\n  gapClick?: boolean;\n  /** Light the item that receives keyboard focus. On by default. */\n  followFocus?: boolean;\n}\n\nconst defaultDisabled = (item: HTMLElement) =>\n  item.matches(\":disabled, [aria-disabled='true'], [data-disabled]\");\n\n/** Controls that sit between items keep their own clicks. */\nconst CONTROL = \"input, textarea, select, button, a, summary, [contenteditable], [role='textbox'], [role='searchbox'], [role='button']\";\n\n/** The item's box relative to the container, summing offsets through positioned ancestors in between. */\nexport function rectOf(item: HTMLElement, container: HTMLElement): FluidRect {\n  let top = item.offsetTop, left = item.offsetLeft;\n  let parent = item.offsetParent as HTMLElement | null;\n  while (parent && parent !== container && container.contains(parent)) {\n    top += parent.offsetTop + parent.clientTop;\n    left += parent.offsetLeft + parent.clientLeft;\n    parent = parent.offsetParent as HTMLElement | null;\n  }\n  return { top, left, width: item.offsetWidth, height: item.offsetHeight };\n}\n\n/**\n * The item the pointer is inside, or else the one whose edge is nearest along the axis (both axes for a grid). Edges, not\n * centres, so a gap next to a wide item still lights the item the pointer is closer to.\n */\nexport function pickNearest(items: HTMLElement[], x: number, y: number, axis: \"x\" | \"y\" | \"xy\"): HTMLElement | null {\n  let nearest: HTMLElement | null = null, best = Infinity;\n  for (const item of items) {\n    const r = item.getBoundingClientRect();\n    if (!r.width && !r.height) continue;\n    if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) return item;\n    const dx = Math.max(r.left - x, 0, x - r.right), dy = Math.max(r.top - y, 0, y - r.bottom);\n    const distance = axis === \"x\" ? dx : axis === \"y\" ? dy : Math.hypot(dx, dy);\n    if (distance < best) { best = distance; nearest = item; }\n  }\n  return nearest;\n}\n\n/** Hands a gap click to the item as a real mouse click (detail, modifiers and coordinates kept), so the item reads it as a pointer press, not a keyboard one. */\nfunction forwardClick(item: HTMLElement, event: MouseEvent<HTMLElement>) {\n  const { detail, clientX, clientY, screenX, screenY, ctrlKey, shiftKey, altKey, metaKey, button, buttons } = event;\n  item.dispatchEvent(new globalThis.MouseEvent(\"click\", { bubbles: true, cancelable: true, composed: true, view: window, detail, clientX, clientY, screenX, screenY, ctrlKey, shiftKey, altKey, metaKey, button, buttons }));\n}\n\n/** Whether an event happened inside the element whose handler hears it, not in a portalled child (a submenu, a tooltip). */\nconst isOwn = (event: { currentTarget: EventTarget; target: EventTarget }) =>\n  !(event.currentTarget instanceof Node) || !(event.target instanceof Node) || event.currentTarget.contains(event.target);\n\nexport function useFluidHover<T extends HTMLElement>(container: RefObject<T | null>, options: FluidHoverOptions) {\n  const { items: selector, axis = \"y\", isItemDisabled = defaultDisabled, disabled = \"skip\", gapClick = true, followFocus = true } = options;\n  const [state, setState] = useState<FluidHoverState>({ rect: null, item: null, glide: false, session: 0 });\n  const current = useRef(state);\n  const pointer = useRef(false);\n  const entering = useRef(false);\n  const frame = useRef(0);\n\n  function commit(next: FluidHoverState) {\n    const prev = current.current;\n    if (prev.item === next.item && prev.session === next.session && sameRect(prev.rect, next.rect)) return;\n    current.current = next;\n    setState(next);\n  }\n\n  function light(item: HTMLElement | null, glide: boolean) {\n    const root = container.current;\n    if (!root || !item) return commit({ ...current.current, rect: null, item: null, glide });\n    let session = current.current.session;\n    if (entering.current) { entering.current = false; session += 1; }\n    commit({ rect: rectOf(item, root), item, glide: glide && session === current.current.session, session });\n  }\n\n  const enabledItems = () => {\n    const root = container.current;\n    return root ? [...root.querySelectorAll<HTMLElement>(selector)].filter(item => !isItemDisabled(item)) : [];\n  };\n\n  // The lit item can move under a still highlight (a resize, content above it changing): follow it without travel.\n  const follow = useEffectEvent(() => { const { item } = current.current; if (item?.isConnected) light(item, false); });\n  useEffect(() => {\n    const root = container.current;\n    if (!root || typeof ResizeObserver === \"undefined\") return;\n    const observer = new ResizeObserver(() => follow());\n    observer.observe(root);\n    return () => observer.disconnect();\n  }, [container]);\n  useEffect(() => () => cancelAnimationFrame(frame.current), []);\n\n  const handlers = {\n    onMouseEnter: () => { entering.current = true; },\n    onMouseMove: (event: MouseEvent<T>) => {\n      if (!isOwn(event)) return;\n      pointer.current = true;\n      const { clientX, clientY } = event;\n      cancelAnimationFrame(frame.current);\n      frame.current = requestAnimationFrame(() => {\n        const over = disabled === \"clear\" ? document.elementFromPoint(clientX, clientY)?.closest<HTMLElement>(selector) : null;\n        light(over && isItemDisabled(over) ? null : pickNearest(enabledItems(), clientX, clientY, axis), true);\n      });\n    },\n    onMouseLeave: () => { cancelAnimationFrame(frame.current); entering.current = false; light(null, false); },\n    onKeyDownCapture: () => { pointer.current = false; },\n    onFocus: (event: FocusEvent<T>) => {\n      if (!followFocus || pointer.current || !isOwn(event)) return;\n      const item = event.target instanceof HTMLElement ? event.target.closest<HTMLElement>(selector) : null;\n      if (item && container.current?.contains(item) && !isItemDisabled(item)) light(item, false);\n    },\n    onBlur: (event: FocusEvent<T>) => {\n      if (!pointer.current && !event.currentTarget.contains(event.relatedTarget as Node | null)) light(null, false);\n    },\n    onClick: (event: MouseEvent<T>) => {\n      if (!gapClick || !isOwn(event)) return;\n      const target = event.target as Element;\n      if (!target.isConnected || target.closest(selector) || target.closest(CONTROL)) return;\n      const { item } = current.current;\n      if (item?.isConnected && !isItemDisabled(item)) forwardClick(item, event);\n    },\n  };\n\n  /** Clears the highlight at once, such as when a menu opens again. */\n  const reset = () => { cancelAnimationFrame(frame.current); entering.current = true; light(null, false); };\n\n  return { ...state, handlers, reset, light };\n}\n\nexport interface NearestItemOptions extends Omit<FluidHoverOptions, \"followFocus\"> {\n  /** Called with the nearest enabled item as the mouse moves over the container. */\n  onPick: (item: HTMLElement) => void;\n}\n\n/**\n * Fluid hover's picking without its highlight, for a list that already keeps its own active item and highlight (a listbox\n * with aria-activedescendant, a roving list): the mouse picks the nearest enabled item, gaps and padding included, and a\n * click in a gap goes to that item. Spread the result on the container.\n */\n// A hook only so callbacks that touch refs can be passed during render; it keeps no state.\nexport function useNearestItem<T extends HTMLElement>({ items: selector, axis = \"y\", isItemDisabled = defaultDisabled, gapClick = true, onPick }: NearestItemOptions) {\n  const nearest = (event: MouseEvent<T>) => {\n    if (!isOwn(event)) return null;\n    const items = [...event.currentTarget.querySelectorAll<HTMLElement>(selector)].filter(item => !isItemDisabled(item));\n    return pickNearest(items, event.clientX, event.clientY, axis);\n  };\n  return {\n    onPointerMove: (event: PointerEvent<T>) => { if (event.pointerType !== \"mouse\") return; const item = nearest(event); if (item) onPick(item); },\n    onClick: (event: MouseEvent<T>) => {\n      if (!gapClick) return;\n      const target = event.target as Element;\n      if (!target.isConnected || target.closest(selector) || target.closest(CONTROL)) return;\n      const item = nearest(event);\n      if (item) forwardClick(item, event);\n    },\n  };\n}\n\nconst sameRect = (a: FluidRect | null, b: FluidRect | null) =>\n  a === b || (!!a && !!b && a.top === b.top && a.left === b.left && a.width === b.width && a.height === b.height);\n\nexport interface FluidHoverHighlightProps {\n  /** The state from useFluidHover (or any { rect, glide, session }). */\n  hover: Pick<FluidHoverState, \"rect\" | \"glide\" | \"session\">;\n  /** Radius, fill, z-index. The container must be position: relative; the highlight is placed at its top-left corner. */\n  className?: string;\n  /** Extra attributes for styling, such as data-tone. */\n  tone?: string;\n}\n\n/** The one highlight a fluid hover set renders: it springs between items on transforms, and fades in and out. */\nexport function FluidHoverHighlight({ hover, className, tone }: FluidHoverHighlightProps) {\n  const reduced = useReducedMotion() ?? false;\n  const { rect, glide, session } = hover;\n  const place = rect ? { x: rect.left, y: rect.top, width: rect.width, height: rect.height } : undefined;\n  return (\n    <AnimatePresence initial={false}>\n      {place ? (\n        <motion.span key={session} className={className} data-tone={tone} aria-hidden=\"true\"\n          style={{ position: \"absolute\", top: 0, left: 0, pointerEvents: \"none\" }}\n          initial={{ opacity: 0, ...place }}\n          animate={{ opacity: 1, ...place }}\n          exit={{ opacity: 0, transition: motionTokens.spring.fast.exit }}\n          transition={{ default: glide && !reduced ? motionTokens.spring.fast : { duration: 0 }, opacity: { duration: motionTokens.duration.fast } }} />\n      ) : null}\n    </AnimatePresence>\n  );\n}\n"}],"docs":"Docs and live preview: https://ui.teamofsilicons.com/phone-input","meta":{"tier":"free","kind":"component","docs":"https://ui.teamofsilicons.com/phone-input","markdown":"https://ui.teamofsilicons.com/phone-input.md","tags":["inputs","new"],"status":"stable"}}
