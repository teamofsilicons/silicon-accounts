{
  "name": "@silicon-accounts/web",
  "version": "0.2.0",
  "private": true,
  "description": "Silicon Accounts web (Next.js): the account site, hosted sign-in pages, documentation redirects, the embed page and sdk/v1.js",
  "scripts": {
    "dev": "pnpm build:sdk && pnpm build:docs && pnpm build:llms && next dev --port ${PORT:-8590}",
    "build": "pnpm build:sdk && pnpm build:docs && pnpm build:llms && next build",
    "start": "next start --port ${PORT:-8590}",
    "typecheck": "tsx lib/docs/build.ts --quiet && tsx lib/agent/build-llms.ts --quiet && next typegen && tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "build:sdk": "node sdk/build.mjs",
    "build:docs": "tsx lib/docs/build.ts",
    "build:llms": "tsx lib/agent/build-llms.ts",
    "test": "tsx lib/agent/build-llms.ts --quiet && tsx --test tests/*.test.ts lib/branding/apply.test.ts components/auth/test/*.test.ts",
    "test:redirects": "tsx --test tests/docs-redirects.test.ts",
    "screens": "tsx scripts/screens.ts",
    "brand": "node scripts/brand/render.mjs",
    "checks:account": "tsx components/account/checks.ts",
    "checks:auth": "tsx components/auth/checks.ts",
    "e2e": "tsx e2e/run.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@radix-ui/react-accordion": "1.2.21",
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0"
}
