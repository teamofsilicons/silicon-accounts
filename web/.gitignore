# Dependencies
/node_modules

# Next.js (`.next-<port>/` and its `.next-<port>.tsconfig.json`: the build of one local stack, see next.config.ts)
/.next/
/.next-*/
/.next-*.tsconfig.json
/.next-*.tsconfig.json.*.tmp
/out/
next-env.d.ts
*.tsbuildinfo

# Built by `pnpm build:sdk` (sdk/v1.ts → public/sdk/v1.js) before dev and build
/public/sdk/

# Built by `pnpm build:llms` (web/llms → the agent files' module) before dev, build, typecheck and test
/lib/agent/generated/

# Built by `pnpm build:docs` (../docs → the bundled pages and the raw Markdown) before dev, build and typecheck
/lib/docs/generated/
/public/docs/
/public/docs.md

# Screenshots from `pnpm screens`
/.screens/

# Playwright and test output
/test-results/
/playwright-report/
/e2e/.artifacts/

# Local environment
.env*
!.env.example

# Misc
.DS_Store
*.pem
npm-debug.log*
.pnpm-debug.log*
