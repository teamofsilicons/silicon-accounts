{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Encrypted app-isolated browser refresh coordination for Silicon Vercel frontends.",
  "Resources": {
    "Provider": {
      "Type": "AWS::IAM::OIDCProvider",
      "Properties": {
        "Url": "https://oidc.vercel.com/saketdev12-5675s-projects",
        "ClientIdList": [
          "https://vercel.com/saketdev12-5675s-projects"
        ]
      }
    },
    "Sessions": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "silicon-browser-sessions-production",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expires",
          "Enabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        },
        "Tags": [
          {
            "Key": "Service",
            "Value": "silicon-browser-sessions"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "WriteRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "silicon-write-browser-sessions",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "Provider"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "oidc.vercel.com/saketdev12-5675s-projects:aud": "https://vercel.com/saketdev12-5675s-projects",
                  "oidc.vercel.com/saketdev12-5675s-projects:sub": "owner:saketdev12-5675s-projects:project:silicon-write-web:environment:production"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "BrowserSessionState",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Sessions",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "write#*"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "DiaryRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "silicon-diary-browser-sessions",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
