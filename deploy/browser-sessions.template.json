    }
  },
  "Outputs": {
    "TableName": {
      "Value": {
        "Ref": "Sessions"
      }
    },
    "Region": {
      "Value": {
        "Ref": "AWS::Region"
      }
    },
    "WriteRole": {
      "Value": {
        "Fn::GetAtt": [
          "WriteRole",
          "Arn"
        ]
      }
    },
    "DiaryRole": {
      "Value": {
        "Fn::GetAtt": [
          "DiaryRole",
          "Arn"
        ]
      }
    },
    "ExtendRole": {
      "Value": {
        "Fn::GetAtt": [
