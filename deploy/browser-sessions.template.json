            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "Provider"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "oidc.vercel.com/saketdev12-5675s-projects:aud": "https://vercel.com/saketdev12-5675s-projects",
                  "oidc.vercel.com/saketdev12-5675s-projects:sub": "owner:saketdev12-5675s-projects:project:silicon-diary-web:environment:production"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "BrowserSessionState",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Sessions",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "diary#*"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ExtendRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
