# Silicon Accounts — local development settings.
#
# Copy to .env (cp .env.example .env). Every value here works out of the box with the local
# Postgres from scripts/dev-db.sh. Unset variables fall back to the same development defaults,
# so .env only needs what you change.
#
# Values marked DEV ONLY are public and must never be used outside local development:
# with ACCOUNTS_ENVIRONMENT=production the service refuses to start with any of them.

# --- Service -------------------------------------------------------------------------------------
# development | test | production
ACCOUNTS_ENVIRONMENT=development
ACCOUNTS_BIND_ADDR=127.0.0.1:8590
# Browser-facing origin of the site and API; also the token issuer.
ACCOUNTS_PUBLIC_URL=http://localhost:8590
# Extra origins allowed to call cookie-authenticated endpoints and receive first-party redirects
# (comma separated), e.g. the Vite dev server.
ACCOUNTS_EXTRA_ALLOWED_ORIGINS=http://localhost:5190
# Serve the built web app from this directory (empty = don't serve it).
ACCOUNTS_WEB_DIST=
ACCOUNTS_LOG_FILTER=info,accounts=debug
# Run webhook delivery, the email/SMS sender and sweeps inside accounts-api.
ACCOUNTS_WORKER_ENABLED=true

# --- Database ------------------------------------------------------------------------------------
ACCOUNTS_DATABASE_URL=postgres://postgres@127.0.0.1:5444/silicon_accounts
ACCOUNTS_DATABASE_MAX_CONNECTIONS=32

# --- Secrets (DEV ONLY) --------------------------------------------------------------------------
# Pepper for every stored token hash: base64url of 32 random bytes.
# Generate: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
ACCOUNTS_TOKEN_PEPPER=MpCAPN8YjuX0SqKr_TERF-YQqhWAYWUuiCf01s2yZT0
# AES-256-GCM keys by version (JSON); new ciphertexts use the current version, old ones still decrypt.
ACCOUNTS_ENCRYPTION_KEYRING='{"1":"p08VPTPd6SNsaUqyQXvLNZsCJzmEAfDr4dfTTWiubZM"}'
ACCOUNTS_ENCRYPTION_CURRENT_VERSION=1
# Ed25519 signing key for access tokens and id_tokens: a base64url 32-byte seed, or a PKCS#8 PEM
# (openssl genpkey -algorithm ed25519; write newlines as \n on one line).
ACCOUNTS_JWT_PRIVATE_KEY=yiG8SlUChKbHOf56uYdM_CQCM9PJz9TOyIKU61VcuCU
ACCOUNTS_JWT_KEY_ID=dev-1
# Service token for /v1/internal/* (Silicon Apps sync), at least 32 characters.
ACCOUNTS_INTERNAL_TOKEN=sa_internal_dev_o-uV-Sg_t0uXiiF6vUWQvqzr4x4bhkmT

# --- Cookies -------------------------------------------------------------------------------------
# true in production (cookie names then get the __Host- prefix and require https).
ACCOUNTS_COOKIE_SECURE=false

# --- Email and SMS -------------------------------------------------------------------------------
# local = never send; messages are stored and visible in the dev outbox.
# providers = send email with Postmark and SMS with Twilio.
ACCOUNTS_DELIVERY=local
ACCOUNTS_EXPOSE_DEV_OUTBOX=true
ACCOUNTS_POSTMARK_SERVER_TOKEN=
ACCOUNTS_POSTMARK_FROM=accounts@teamofsilicons.com
# Mock server from testkit: http://127.0.0.1:8592/postmark
ACCOUNTS_POSTMARK_API_URL=https://api.postmarkapp.com
ACCOUNTS_TWILIO_ACCOUNT_SID=
ACCOUNTS_TWILIO_AUTH_TOKEN=
# MessagingServiceSid is preferred; From is used when it is empty.
ACCOUNTS_TWILIO_MESSAGING_SERVICE_SID=
ACCOUNTS_TWILIO_FROM=
# Mock server from testkit: http://127.0.0.1:8592/twilio
ACCOUNTS_TWILIO_API_URL=https://api.twilio.com
# Bug reports (accounts report …) go to these addresses.
ACCOUNTS_REPORT_RECIPIENTS=saketdev12@gmail.com,shubhastro2@gmail.com,bugs@teamofsilicons.com

# --- Google (managed "one click" credentials; empty = one-click Google is off) --------------------
ACCOUNTS_GOOGLE_CLIENT_ID=
ACCOUNTS_GOOGLE_CLIENT_SECRET=
ACCOUNTS_GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
ACCOUNTS_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
ACCOUNTS_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
ACCOUNTS_GOOGLE_ISSUERS=https://accounts.google.com,accounts.google.com

# --- Apple (managed "one click" credentials; all four or none) ------------------------------------
ACCOUNTS_APPLE_SERVICES_ID=
ACCOUNTS_APPLE_TEAM_ID=
ACCOUNTS_APPLE_KEY_ID=
# The .p8 key as PEM; write newlines as \n on one line.
ACCOUNTS_APPLE_PRIVATE_KEY=
ACCOUNTS_APPLE_AUTH_URL=https://appleid.apple.com/auth/authorize
ACCOUNTS_APPLE_TOKEN_URL=https://appleid.apple.com/auth/token
ACCOUNTS_APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
ACCOUNTS_APPLE_ISSUER=https://appleid.apple.com

# --- Network and links ---------------------------------------------------------------------------
# Default profile photos: {iris}/pfp/carbon?id={uuid} and {iris}/pfp/silicon?id={uuid}.
ACCOUNTS_IRIS_BASE_URL=https://iris.teamofsilicons.com
# Request headers that carry the client's IANA timezone (first valid one wins).
ACCOUNTS_IP_TIMEZONE_HEADERS=cloudfront-viewer-time-zone,x-vercel-ip-timezone
# true only behind a load balancer that appends the client IP to X-Forwarded-For.
ACCOUNTS_TRUST_FORWARDED_FOR=false
# Where "make a new app" sends Carbons.
ACCOUNTS_SILICON_APPS_URL=https://apps.teamofsilicons.com
# Allow http and private/loopback webhook URLs (true in development so fake apps on 127.0.0.1 work).
# Production refuses true: it turns the webhook SSRF guard off.
ACCOUNTS_WEBHOOK_ALLOW_PRIVATE=true

# --- Telemetry (Space Station) -------------------------------------------------------------------
ACCOUNTS_TELEMETRY_ENABLED=true
# The tos.spacestation table key; empty = telemetry silently off.
ACCOUNTS_TELEMETRY_TABLE_KEY=

# --- Contract values (production refuses anything else) ------------------------------------------
ACCOUNTS_OTP_TTL_SECONDS=600
# Cooldown after 10 wrong codes; tests may shorten it outside production.
ACCOUNTS_OTP_LOCK_SECONDS=60
ACCOUNTS_ACCESS_TOKEN_TTL_SECONDS=1800
